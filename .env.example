# --- LLM (OpenAI-compatible chat completions endpoint) ---
# Base URL of the /v1 API root (no trailing /chat/completions).
# Examples: http://localhost:1234/v1  (LM Studio)
#           https://api.openai.com/v1
#           https://api.groq.com/openai/v1
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=local-model

# Rate limits (critical for Groq free tier — keep calls spaced out)
# Minimum seconds between LLM calls (global lock). Groq free ≈ ~30 RPM.
LLM_MIN_INTERVAL_SECONDS=3
# How many times to retry on HTTP 429 before cooling down
LLM_MAX_RETRIES=4
# Set to 1 to score severity via LLM (uses extra tokens). Default 0 = rules only.
LLM_TRIAGE_ENABLED=0

# Per-user search quota (1 unit = one check / quick check / discovery)
DEFAULT_USER_QUOTA=2
# Comma-separated usernames that are admins. Strongly recommended.
# If set, ONLY these users get Admin (everyone else is demoted on startup).
# If empty, only the first registered user is admin — later signups never are.
ADMIN_USERNAMES=

# Discovery search backend (Section 2). duckduckgo needs no API key.
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
SEARCH_BASE_URL=

# --- Notion (optional; Notion agent is skipped if unset) ---
NOTION_TOKEN=secret_replace-me
NOTION_PAGE_ID=replace-with-notion-page-id

# --- Notifications (optional) ---
# Generic webhook that receives a JSON POST when a high-priority change is
# detected. Leave unset to only log alerts. Works with Slack/Discord-style
# incoming webhooks or any endpoint of your own.
NOTIFY_WEBHOOK_URL=

# Optional SMTP email notifier (digests + alerts). All four of host/from/to
# must be set for email delivery; otherwise digests are still stored locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Escalate fetch fallbacks (archive.org etc.) after this many consecutive failures
FETCH_FAILURE_THRESHOLD=3

# --- Hosted database (Turso / libSQL) ---
# Required on Render (or any host with an ephemeral disk). Local `python app.py`
# without these still uses data/tracktect.db.
# Create a DB at https://turso.tech then paste:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 to refuse the local file even off Render (useful for deploy smoke tests).
REQUIRE_TURSO=0

# --- Flask ---
# Secret key for session cookies. REQUIRED for live demos — use a long random string.
# Example (PowerShell): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-string
# Set to 1 when the site is served over HTTPS (required for secure session cookies).
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
